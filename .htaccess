RewriteCond %{HTTP_REFERER} !^http://awmpc.org$      [NC]
RewriteCond %{HTTP_REFERER} !^http://worldmissionprayercenter.org/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://worldmissionprayercenter.org$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.awmpc.org/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.awmpc.org$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.worldmissionprayercenter.org/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.worldmissionprayercenter.org$      [NC]
RewriteCond %{HTTP_REFERER} !^https://awmpc.org/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://awmpc.org$      [NC]
RewriteCond %{HTTP_REFERER} !^https://worldmissionprayercenter.org/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://worldmissionprayercenter.org$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.awmpc.org/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.awmpc.org$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.worldmissionprayercenter.org/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.worldmissionprayercenter.org$      [NC]


# BEGIN HTTPS Forced Redirect
# The directives (lines) between "BEGIN HTTPS Forced Redirect" and 
# "END HTTPS Forced Redirect" are dynamically generated, and should 
# only be modified via the filters. Any changes to the directives between 
# these markers will be overwritten.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# END HTTPS Forced Redirect

Options -Indexes
RewriteOptions inherit
RewriteEngine on

RewriteRule .? - [E=Donation-Amount:%{HTTP:Donation-Amount}]

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.awmpc\.org$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/cpanel-dcv/[0-9a-zA-Z_-]+$
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/(?:\ Ballot169)?
RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteRule ^(.*)$ https://awmpc.org/$1 [L,R=301]

# Redirect /index.html https://awmpc.org/wmpc_pager.php?page=mi_home

# --- Compression ---

# Brotli compression (preferred, requires mod_brotli)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
    AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS application/xml application/xhtml+xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# Gzip compression fallback (mod_deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml

    # Don't compress already-compressed files
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|mp4|mp3|wmv|avi|mpg|m4v)$ no-gzip dont-vary
</IfModule>

# --- Security Headers ---

<IfModule mod_headers.c>
    # Make sure proxies don't deliver the wrong content
    Header append Vary User-Agent env=!dont-vary

    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"

    # HTTPS enforcement (1 year with subdomains + preload)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content Security Policy
    # TODO: how to embed youtube iframes with "default-src 'self';"
    Header set Content-Security-Policy "base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" "expr=%{CONTENT_TYPE} =~ m#text\/(html|javascript)|xml#i"
    Header set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests" "expr=%{CONTENT_TYPE} =~ m#application\/pdf#i"

    # Prevent MIME-type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Referrer policy (send origin on cross-origin, full URL on same-origin)
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy (replaces deprecated Feature-Policy)
    Header always set Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(), sync-xhr=(self)"

    # Cache-Control: allow caching but require revalidation for HTML
    Header set Cache-Control "public, no-cache" "expr=%{CONTENT_TYPE} =~ m#text/html#i"
    Header set Cache-Control "no-cache, no-store, must-revalidate" "expr=%{REQUEST_URI} =~ m#/sw\.js$#"

    # Removed deprecated headers:
    # - X-XSS-Protection (removed from modern browsers, CSP is the replacement)
    # - Expect-CT (deprecated, CT is now required by default)
    # - Public-Key-Pins / HPKP (removed from all browsers, risk of bricking site)
    # - Feature-Policy (replaced by Permissions-Policy above)
</IfModule>

# --- Hotlink Protection ---

